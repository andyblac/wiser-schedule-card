{
  "name": "wiser-schedule-card",
  "version": "2.0.0",
  "description": "Wiser Schedule Card",
  "keywords": [
    "home-assistant",
    "homeassistant",
    "hass",
    "automation",
    "lovelace",
    "custom-cards"
  ],
  "module": "wiser-schedule-card.js",
  "repository": "git+https://github.com/msp1974/wiser-schedule-card.git",
  "author": "Mark Parker <msparker@sky.com>",
  "license": "MIT",
  "dependencies": {
    "@mdi/js": "^7.4.47",
    "custom-card-helpers": "^1.9.0",
    "fecha": "^4.2.3",
    "hex-rgb": "^5.0.0",
    "home-assistant-js-websocket": "^9.5.0",
    "lit": "^3.2.1",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^15.3.0",
    "@rollup/plugin-terser": "^0.4.4",
    "playwright": "^1.58.2",
    "prettier": "^3.3.3",
    "rollup": "^4.18.0",
    "rollup-plugin-serve": "^1.1.1",
    "typescript": "^5.6.3"
  },
  "scripts": {
    "start": "rollup -c rollup.config.dev.js --watch --bundleConfigAsCjs",
    "build": "npm run lint && npm run rollup",
    "lint": "npm run typecheck",
    "rollup": "rollup -c --bundleConfigAsCjs",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test tests/schedule-overview.test.cjs tests/panel.test.cjs && node tests/browser.cjs && node tests/panel-browser.cjs",
    "build:dev": "npm run typecheck && rollup -c --configDev --bundleConfigAsCjs",
    "test:build": "node --test tests/build-version.test.mjs"
  },
  "engines": {
    "node": ">=22"
  }
}
